# Copy this file to .env and fill in your own credentials. .env is git-ignored:
# never commit real credentials. Secrets stay in the local server (server/index.ts)
# and are never sent to the browser.

# Space-Track.org account (free registration: https://www.space-track.org/auth/createAccount)
SPACETRACK_IDENTITY=
SPACETRACK_PASSWORD=

# N2YO API key (free: create an account on n2yo.com, then "API" in your profile)
N2YO_API_KEY=

# OpenAI API key for the decision agent (model gpt-4o-mini). Paid API: usage is billed by OpenAI.
OPENAI_API_KEY=

# Optional
# ORBITAL_SERVER_PORT=8787
# ORBITAL_SERVER_HOST=127.0.0.1
